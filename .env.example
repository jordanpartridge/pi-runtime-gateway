# Local Pi gateway configuration. Values are dotenv-quoted literal strings, never evaluated as shell code.
# Keep this file portable; setup creates .env without replacing existing settings.
PI_GATEWAY_PROFILE="config/local.json"
PI_GATEWAY_PI_BINARY="pi"
PI_GATEWAY_MODEL="qwen3-coder-next:latest"
PI_GATEWAY_OLLAMA_URL="http://127.0.0.1:11434"
PI_GATEWAY_PORT="4319"
PI_GATEWAY_STATE_DIR=".runtime"
